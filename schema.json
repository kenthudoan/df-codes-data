{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/kenthudoan/df-codes-data/main/schema.json",
  "title": "Community Giftcode Feed",
  "type": "object",
  "required": ["version", "lastUpdated", "source", "codes"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "number", "minimum": 1},
    "lastUpdated": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "minVotes": {"type": "integer", "minimum": 1}, "schemaUrl": {"type": "string", "format": "uri"}}},
    "counts": {"type": "object", "required": ["total", "tierSafe", "tierRisky", "tierUnknown"], "additionalProperties": false, "properties": {"total": {"type": "integer", "minimum": 0}, "tierSafe": {"type": "integer", "minimum": 0}, "tierRisky": {"type": "integer", "minimum": 0}, "tierUnknown": {"type": "integer", "minimum": 0}}},
    "codes": {"type": "array", "items": {"type": "object", "required": ["id", "code"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1},
      "code": {"type": "string", "minLength": 6, "maxLength": 40, "pattern": "^[A-Za-z0-9_-]+$"},
      "title": {"type": "string"}, "description": {"type": "string"},
      "source": {"type": "string", "format": "uri"},
      "tags": {"type": "array", "items": {"type": "string"}},
      "tier": {"type": "string", "enum": ["safe", "risky", "broken", "unknown"]},
      "verifiedAt": {"type": "string"},
      "validFrom": {"type": "string", "format": "date-time"},
      "validUntil": {"type": "string", "format": "date-time"},
      "addedAt": {"type": "string", "format": "date-time"}
    }}}
  }
}
